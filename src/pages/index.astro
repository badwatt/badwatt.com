---
import { getCollection } from "astro:content";

import Layout from "src/site/layouts/Layout.astro";
import { LoadingScreen } from "src/site/components/LoadingScreen";
import { ScrollProgress } from "src/site/components/ScrollProgress";
import { CursorGlow } from "src/site/components/CursorGlow";
import { Scrollup } from "src/site/components/Scrollup";
import { Marquee } from "src/site/components/Marquee";
import { Home } from "src/site/sections/Home";
import { About } from "src/site/sections/About";
import { Stats } from "src/site/sections/Stats";
import { Skills } from "src/site/sections/Skills";
import { Experience } from "src/site/sections/Experience";
import { Portfolio } from "src/site/sections/Portfolio";
import { CV } from "src/cv/ui/CV";
import { Contact } from "src/contact/ui/Contact";
import { loadSiteContent, type ContentSource } from "src/content/application/siteContent";

const contentSource: ContentSource = {
  experience: async () =>
    (await getCollection("experience")).map((e) => ({
      title: e.data.title,
      image: e.data.image.src,
      date_from: e.data.date_from,
      date_to: e.data.date_to,
      url: e.data.url,
      description: e.body?.trim() ?? "",
    })),
  portfolio: async () =>
    (await getCollection("portfolio")).map((e) => ({
      title: e.data.title,
      image: e.data.image.src,
      url: e.data.url,
      description: e.body?.trim() ?? "",
    })),
  about: async () =>
    (await getCollection("about")).map((e) => ({
      email: e.data.email,
      location: e.data.location,
      languages: e.data.languages,
      education: e.data.education,
      bio: e.body?.trim() ?? "",
    })),
  skills: async () =>
    (await getCollection("skills")).map((e) => ({
      title: e.data.title,
      image: e.data.image.src,
      url: e.data.url,
      featured: e.data.featured,
    })),
};

const { experience: experienceData, portfolio: portfolioData, about: aboutData, skills: skillsData } =
  await loadSiteContent(contentSource);

const techStack = skillsData.map((s) => s.title);
---

<Layout>
  <LoadingScreen client:load />
  <ScrollProgress client:load />
  <CursorGlow client:load />
  <Home client:load experienceData={experienceData} aboutData={aboutData} skillsData={skillsData} />
  <Marquee items={techStack} speed={35} />
  <About client:load aboutData={aboutData} />
  <Stats client:load experienceData={experienceData} portfolioData={portfolioData} skillsData={skillsData} />
  <Skills client:load skillsData={skillsData} />
  <Experience client:load experienceData={experienceData} />
  <Portfolio client:load portfolioData={portfolioData} />
  <CV client:load experienceData={experienceData} aboutData={aboutData} skillsData={skillsData} />
  <Contact client:load />
  <Scrollup client:load />
</Layout>
